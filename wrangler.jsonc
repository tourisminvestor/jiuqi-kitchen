{
  "name": "jiuqi-kitchen",
  "main": "source/dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "source/dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
